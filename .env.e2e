# The environment the browser drivers run in: the local emulator suite, never a real project.
#
# This file is COMMITTED and holds no secret, which is the point of a `demo-` project id: the
# Firebase SDKs refuse to contact any real backend for one, so the isolation does not depend on
# anybody remembering to set a variable. The e2e suite filled the production catalogue with 306
# listings and 644 auth accounts once; this is the fix.
#
#   pnpm emulators     # one terminal: auth, firestore and storage, with the real rules loaded
#   pnpm dev:e2e       # another: the app pointed at them
#   pnpm e2e:env       # a third: the drivers
#
# Nothing here needs to be secret, so a fresh clone can run the suite with no setup at all.

# Port 3100, not 3000: an ordinary `pnpm dev` pointed at the real project can stay up beside
# this one, and the drivers cannot wander into it by accident.
E2E_BASE_URL=http://localhost:3100

NEXT_PUBLIC_FIREBASE_USE_EMULATOR=1
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-mad-e2e
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-mad-e2e.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-mad-e2e.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=0
NEXT_PUBLIC_FIREBASE_APP_ID=1:0:web:demomade2e
# The Auth emulator ignores the key entirely, so this is a placeholder and not a credential.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-emulator-key

FIREBASE_PROJECT_ID=demo-mad-e2e
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# Empty on purpose: every stage movement sends a notification, and a full run is dozens of
# messages against Resend's 100-a-day free tier. Without a key the subject is logged instead,
# which is also how a driver reads the signature code.
RESEND_API_KEY=
