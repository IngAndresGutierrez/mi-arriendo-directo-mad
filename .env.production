# Firebase web config — PUBLIC by design, and git-tracked on purpose.
#
# These values ship inside the browser bundle no matter what: Next inlines every
# NEXT_PUBLIC_* variable at BUILD time. They are not secrets — access control comes from
# firestore.rules / storage.rules, never from hiding this config.
#
# They live here rather than in Vercel because the team enforces sensitive environment
# variables, and a sensitive variable never reaches the build step. A NEXT_PUBLIC_* value
# that is missing at build time is inlined as `undefined`, and the web SDK then fails with
# `auth/invalid-api-key` in the browser — a build that goes green and an app that does not work.
#
# The service account (FIREBASE_PROJECT_ID / FIREBASE_CLIENT_EMAIL / FIREBASE_PRIVATE_KEY)
# is NOT here and never will be: those stay as sensitive Vercel variables, read at request
# time by the lazy accessors in shared/firebase/admin.ts.
#
# Local development keeps using .env.local, which Next loads with higher priority.

NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDNjhH1vSsSFT2ooB0bVXuxEQktu7ZKNFs
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=mi-arriendo-directo-mad.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=mi-arriendo-directo-mad
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=mi-arriendo-directo-mad.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=58684574578
NEXT_PUBLIC_FIREBASE_APP_ID=1:58684574578:web:4d1cb22edf2e0863a66beb
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-T8BTMETF8D
NEXT_PUBLIC_FIREBASE_USE_EMULATOR=0
