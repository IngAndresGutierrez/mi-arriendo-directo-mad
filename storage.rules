rules_version = '2';

// Identity and income documents: isolated per uid, never public.
service firebase.storage {
  match /b/{bucket}/o {

    function validSize() {
      return request.resource.size > 0 && request.resource.size < 8 * 1024 * 1024;
    }

    // national id documents, employment letters, bank statements
    match /applicants/{userId}/{allPaths=**} {
      allow read:  if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && validSize()
                   && request.resource.contentType
                        .matches('image/(jpeg|png|webp)|application/pdf');
      allow delete: if false;                  // traceability: only the backend deletes
    }

    // listing photos and the walkthrough video: public read, and each landlord writes only
    // inside their own folder. The path is keyed by uid and not by propertyId on purpose: files
    // are uploaded from the browser before the property exists, so there is no id to scope them
    // to yet.
    //
    // Two limits, not one, exactly as in the incidents block below: 8 MB does not hold a
    // walkthrough of a flat, and a 50 MB *photograph* is a mistake nobody makes on purpose. A
    // single 50 MB ceiling for both would turn the second into an accepted upload nobody meant,
    // on a bucket every visitor can read. `validSize()` is the 8 MB one and cannot cover video.
    //
    // **Anchored regexes**, and here that is load-bearing rather than tidiness: `matches` is not
    // anchored on its own, so the `image/(jpeg|png|webp)` this rule used to carry also accepted
    // any contentType with that substring buried in it. This is the one bucket in the product
    // with `allow read: if true`, so it is the one where a permissive match is served to
    // strangers.
    match /properties/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size > 0
                   && (
                        (request.resource.contentType.matches('^image/(jpeg|png|webp)$')
                         && request.resource.size < 8 * 1024 * 1024)
                     || (request.resource.contentType.matches('^video/(mp4|quicktime|webm)$')
                         && request.resource.size < 50 * 1024 * 1024)
                      );
      // the owner may drop a photo or the video they just uploaded, before or after publishing
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // incident photos and videos: what the tenant reports going wrong in the property.
    //
    // Keyed by uid, like the two blocks above, and here that is forced rather than chosen: Storage
    // rules cannot read Firestore, so "is this person a party to that tenancy?" is a question they
    // cannot ask. What they can check is that the path names the uploader. Which tenancy the file
    // belongs to is recorded in Firestore, where the question *can* be asked, and the landlord —
    // who by this rule cannot read the object at all — opens it through a URL the server signs.
    //
    // Two limits, not one: a video is the point of this feature (a leak that only leaks when the
    // tap runs is not a still photograph) and 8 MB does not hold one, while a 50 MB *image* is a
    // mistake nobody makes on purpose. `validSize()` cannot be reused for either.
    //
    // Anchored regexes: `matches` is not anchored on its own, so `image/(jpeg|png|webp)` would also
    // accept a contentType with that substring buried in it.
    match /incidents/{userId}/{allPaths=**} {
      allow read:  if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size > 0
                   && (
                        (request.resource.contentType.matches('^image/(jpeg|png|webp)$')
                         && request.resource.size < 8 * 1024 * 1024)
                     || (request.resource.contentType.matches('^video/(mp4|quicktime|webm)$')
                         && request.resource.size < 50 * 1024 * 1024)
                      );
      // The landlord reads this record: a tenant who could delete the file would leave the report
      // pointing at nothing. Only the backend removes one, as with the identity documents.
      allow delete: if false;
    }

    // the acta de entrega's photos. Keyed by uid like the three blocks above, and forced by the same
    // fact: Storage rules cannot read Firestore, so "is this person a party to that tenancy?" is a
    // question they cannot ask. Which acta a photo belongs to is recorded in Firestore, where it can
    // be — and the other party, who by this rule cannot read the object at all, opens it through a
    // URL the server signs.
    //
    // **Images only, and one limit rather than two.** The incidents take video and argue for it well;
    // an acta is the opposite case, because its value is that a checkout photo can be put beside the
    // check-in photo of the same wall. Two videos of a wall compare worse than two pictures of it.
    //
    // Anchored regex: `matches` is not anchored on its own, so `image/(jpeg|png|webp)` would also
    // accept a contentType with that substring buried in it.
    match /handovers/{userId}/{allPaths=**} {
      allow read:  if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size > 0
                   && request.resource.contentType.matches('^image/(jpeg|png|webp)$')
                   && request.resource.size < 8 * 1024 * 1024;
      // Both parties read this record through the server. A landlord who could delete the photo the
      // tenant objected with would be able to remove the evidence against their own acta.
      allow delete: if false;
    }

    // the certificado de tradición y libertad a landlord attaches to have their ownership verified.
    //
    // **The most sensitive thing this product holds about a property.** That certificate carries the
    // full street address and the owner's identity — which is exactly why the matrícula that pulls it
    // is kept in `properties/{id}/private/location` and never published. So: the uploader reads their
    // own, nobody else reads anything, and the reviewer opens it through a URL the server signs.
    //
    // Keyed by uid like every other block here, and forced by the same fact: Storage rules cannot ask
    // Firestore whether this person owns that property.
    //
    // PDF or a photograph of one, 8 MB. Anchored regex: `matches` is not anchored on its own.
    match /verifications/{userId}/{allPaths=**} {
      allow read:  if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size > 0
                   && (request.resource.contentType == 'application/pdf'
                       || request.resource.contentType.matches('^image/(jpeg|png|webp)$'))
                   && request.resource.size < 8 * 1024 * 1024;
      // A reviewer's decision rests on this file. Somebody who could delete it after being approved
      // would leave a badge standing on evidence that is gone.
      allow delete: if false;
    }

    // signed contracts: generated and served by the backend
    match /contracts/{allPaths=**} {
      allow read, write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;             // explicit closure
    }
  }
}
