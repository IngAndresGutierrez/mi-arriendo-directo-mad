rules_version = '2';

// Documentos de identidad e ingresos: aislados por uid, nunca públicos.
service firebase.storage {
  match /b/{bucket}/o {

    function tamanoValido() {
      return request.resource.size > 0 && request.resource.size < 8 * 1024 * 1024;
    }

    // cédulas, certificados laborales, extractos
    match /postulantes/{userId}/{allPaths=**} {
      allow read:  if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && tamanoValido()
                   && request.resource.contentType
                        .matches('image/(jpeg|png|webp)|application/pdf');
      allow delete: if false;                  // trazabilidad: solo el backend borra
    }

    // fotos del listado: lectura pública, escritura autenticada
    match /inmuebles/{inmuebleId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && tamanoValido()
                   && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    // contratos firmados: los genera y sirve el backend
    match /contratos/{allPaths=**} {
      allow read, write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;             // cierre explícito
    }
  }
}
