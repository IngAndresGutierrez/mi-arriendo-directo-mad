rules_version = '2';

// =============================================================================
// miarriendodirecto.com — Security Rules
//
// Deny by default. Treat the client as hostile: if a rule allows something,
// someone will do it. Sensitive data (identity documents, income, contracts,
// payments) is NOT listable by the client. Anything only the backend may do is
// `if false` here and runs through the Admin SDK, which bypasses these rules.
//
// Test before deploying (the emulator needs JDK 21+):
//   firebase emulators:exec --only firestore --project demo-mad "<test command>"
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------- helpers --------------------------------
    function isSignedIn() {
      return request.auth != null;
    }
    function uid() {
      return request.auth.uid;
    }
    function isOwner(userId) {
      return isSignedIn() && uid() == userId;
    }
    // Roles come from custom claims: the Admin SDK sets them, the client cannot forge them.
    function hasRole(role) {
      return isSignedIn() && request.auth.token.role == role;
    }
    function isLandlord() { return hasRole('landlord'); }
    function isAdmin()    { return hasRole('admin'); }

    function incoming() { return request.resource.data; }
    function current()  { return resource.data; }

    function changedKeys() {
      return incoming().diff(current()).affectedKeys();
    }
    function onlyChanged(keys) {
      return changedKeys().hasOnly(keys);
    }
    function unchanged(fields) {
      return !changedKeys().hasAny(fields);
    }

    // -------------------------------- users ---------------------------------
    match /users/{userId} {
      allow get:  if isOwner(userId) || isAdmin();
      allow list: if isAdmin();                        // nobody enumerates users

      // The profile is written by the backend through the Admin SDK (the
      // `completeProfile` Server Action), which also sets the role custom claim. These
      // rules exist for the case where the client writes directly: same shape, validated.
      allow create: if isOwner(userId)
                    && incoming().keys().hasAll(
                         ['fullName', 'email', 'phone', 'phoneCountry', 'gender',
                          'address', 'birthDate', 'role', 'termsAcceptedAt',
                          'createdAt'])
                    && incoming().keys().hasOnly(
                         ['fullName', 'email', 'phone', 'phoneCountry', 'gender',
                          'address', 'birthDate', 'role', 'termsAcceptedAt',
                          'createdAt', 'updatedAt'])
                    && validProfile()
                    && incoming().email == request.auth.token.email
                    && incoming().role in ['tenant', 'landlord'];

      // The user does NOT change their own role: it is a custom claim only the Admin SDK
      // sets. They cannot rewrite their consent record or their creation date either.
      allow update: if isOwner(userId)
                    && onlyChanged(['fullName', 'phone', 'phoneCountry', 'gender',
                                    'address', 'updatedAt'])
                    && validProfile();
      allow delete: if isAdmin();

      function validProfile() {
        return incoming().fullName is string
            && incoming().fullName.size() >= 5
            && incoming().fullName.size() <= 120
            && incoming().phone is string
            // E.164: country code + number. `[+]` avoids escaping doubts in the literal.
            && incoming().phone.matches('^[+][1-9][0-9]{7,14}$')
            // ISO 3166-1 alpha-2 of the chosen country: `+1` is shared by several
            // countries, so the country cannot be derived from the number.
            && incoming().phoneCountry is string
            && incoming().phoneCountry.matches('^[A-Z]{2}$')
            && incoming().gender in ['female', 'male', 'non_binary',
                                     'prefer_not_to_say']
            && incoming().address.line is string
            && incoming().address.line.size() >= 5
            && incoming().address.line.size() <= 160
            && incoming().address.city is string
            && incoming().address.city.size() <= 80
            && incoming().address.department is string
            && incoming().address.department.size() <= 40;
      }

      // Identity documents: a separate subcollection so a `get` on the profile never
      // exposes the national id. Append-only for the owner.
      match /documents/{documentId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && validDocument(userId);
        allow update, delete: if isAdmin();
      }
      function validDocument(userId) {
        return incoming().keys().hasOnly(['type', 'storagePath', 'uploadedAt'])
            && incoming().type in ['id_front', 'id_back',
                                   'employment_letter', 'bank_statement']
            && incoming().storagePath is string
            && incoming().storagePath.matches('^applicants/' + userId + '/.*');
      }
    }

    // ------------------------------ properties ------------------------------
    match /properties/{propertyId} {
      // Public catalog: published listings only; the owner and admins see all of theirs.
      //
      // CAREFUL: an unfiltered `list` is ALWAYS denied (even on an empty collection), because
      // the rule must be verifiable from the query itself. The public catalog MUST always
      // query with where("status", "==", "available").
      allow get, list: if current().status == 'available'
                       || isPropertyOwner()
                       || isAdmin();

      allow create: if isLandlord()
                    && incoming().landlordUid == uid()
                    && validProperty()
                    && incoming().status in ['draft', 'available'];
      allow update: if (isPropertyOwner() && validProperty()
                        && unchanged(['landlordUid', 'createdAt']))
                    || isAdmin();
      allow delete: if isPropertyOwner() || isAdmin();

      function isPropertyOwner() {
        return isSignedIn() && current().landlordUid == uid();
      }
      function validProperty() {
        return incoming().title is string
            && incoming().title.size() >= 10
            && incoming().title.size() <= 140
            && incoming().description is string
            && incoming().description.size() <= 2000
            && incoming().type in ['apartment', 'house', 'studio', 'retail', 'office']
            && incoming().status in ['draft', 'available', 'rented', 'inactive']
            // money: integer pesos, never a float
            && incoming().rent is int
            && incoming().rent > 0
            && incoming().rent <= 100000000
            && incoming().adminFee is int
            && incoming().adminFee >= 0
            && incoming().minLeaseMonths in [6, 12]
            && incoming().stratum is int
            && incoming().stratum >= 1
            && incoming().stratum <= 6
            && incoming().areaM2 is int
            && incoming().areaM2 > 0
            && incoming().bedrooms is int
            && incoming().bathrooms is int
            && incoming().bathrooms >= 1
            && incoming().parking in ['private', 'communal', 'none']
            && incoming().furnished is bool
            && incoming().petsAllowed is bool
            // the public document carries the neighbourhood, NEVER the street
            && incoming().area.neighborhood is string
            && incoming().area.neighborhood.size() <= 80
            && incoming().area.city is string
            && incoming().area.city.size() <= 80
            && incoming().area.department is string
            && incoming().area.department.size() <= 40
            && !('line' in incoming().area)
            && !('address' in incoming())
            /*
             * The map, and the reason it is two fields and not one.
             *
             * `area.approx` is the blunted coordinate the public map draws a 400 m circle
             * around. `point` is the exact one, and it is FORBIDDEN here: five decimals of
             * latitude is the address written in another alphabet, so allowing it would undo
             * the whole `private/location` split one field at a time.
             *
             * The parentheses are not optional: `&&` binds tighter than `||`, so without them
             * an absent `approx` would swallow every check after it.
             */
            && !('point' in incoming().area)
            && (!('approx' in incoming().area) || (
                 incoming().area.approx.keys().hasOnly(['lat', 'lng'])
                 && incoming().area.approx.lat is number
                 && incoming().area.approx.lng is number
                 // Colombia, islands included. Not a border: a guard against a swapped or
                 // zeroed pair. Mirrors `COLOMBIA_BOUNDS` in shared/geo/point.ts.
                 && incoming().area.approx.lat >= -4.4
                 && incoming().area.approx.lat <= 13.6
                 && incoming().area.approx.lng >= -82.2
                 && incoming().area.approx.lng <= -66.7
               ))
            && incoming().slug is string
            && incoming().slug.size() > 0
            && incoming().slug.size() <= 80
            && incoming().photos is list
            && incoming().photos.size() >= 1
            && incoming().photos.size() <= 20;
      }

      // The exact street address. It lives apart because Security Rules cannot hide a field:
      // granting `get` on the property hands over every key in it, and the catalog is public.
      // Only the owner and admins read it; the backend writes it with the Admin SDK.
      match /private/{documentId} {
        // `isPropertyOwner()` cannot be reused here: inside this match `resource` is the
        // private document, which has no landlordUid. The owner has to be read from the
        // parent. Parentheses are not optional: `&&` binds tighter than `||`.
        allow get, list: if isAdmin()
                         || (isSignedIn()
                             && get(/databases/$(database)/documents/properties/$(propertyId))
                                  .data.landlordUid == uid());
        allow create, update, delete: if false;
      }
    }

    // ------------------------------ slug index ------------------------------
    // `propertySlugs/{slug}` maps a URL to a property id. The document id is the slug, so
    // uniqueness is existence and a page resolves with one `get`. Only the backend touches it:
    // letting a client write here would let anyone squat or hijack another listing's URL, and
    // letting one read it would hand over a full list of every slug in the product.
    match /propertySlugs/{slug} {
      allow read, write: if false;
    }

    // ----------------------------- applications -----------------------------
    // A rental process: seven stages the landlord moves it through — and a seventh that ends by
    // itself when he confirms the first canon. Visible ONLY to the tenant who created it and to
    // the property's landlord.
    //
    // Every write goes through a Server Action with the Admin SDK, which bypasses these rules,
    // so the client cannot write here at all. That is not belt-and-braces: the stage machine
    // has rules a `firestore.rules` file cannot express — only one stage forward, only while
    // open, only by the landlord — and a rule that half-enforces them would be a rule someone
    // trusts.
    match /applications/{applicationId} {
      allow get:  if isApplicationTenant() || isApplicationLandlord() || isAdmin();
      // Bounded `list`: the client cannot sweep the whole collection.
      allow list: if isAdmin()
                  || (isSignedIn()
                      && request.query.limit <= 50
                      && (isApplicationTenant() || isApplicationLandlord()));

      allow create, update, delete: if false;   // Server Actions only

      function isApplicationTenant() {
        return isSignedIn() && current().tenantUid == uid();
      }
      function isApplicationLandlord() {
        return isSignedIn() && current().landlordUid == uid();
      }
    }

    // ----------------------------- notifications ----------------------------
    // What the bell shows. Each one belongs to exactly one person.
    //
    // Written only by the server, and marked read only by the server too: `readAt` is the one
    // field a client could plausibly own, and letting it write would mean letting it write to a
    // document it does not otherwise touch. The Server Action scopes the update to the caller's
    // own uid, which no rule here could check as precisely.
    match /notifications/{notificationId} {
      allow get:  if isSignedIn() && current().recipientUid == uid();
      /*
       * Bounded, and only over one's own. A `list` is evaluated per candidate document, so
       * `recipientUid == uid()` is what forces the query to be filtered: an unfiltered sweep
       * hits somebody else's notification and the whole read is denied.
       *
       * There is no way to inspect a query's filters from here — `request.query` carries only
       * `limit`, `offset` and `orderBy` — and a rule written as if there were is a rule that
       * denies everything.
       */
      allow list: if isSignedIn()
                  && request.query.limit <= 50
                  && current().recipientUid == uid();
      allow create, update, delete: if false;   // Server Actions only
    }

    // ---------------------------- tenantProfiles ----------------------------
    // The tenant's rental dossier: identity document, income, personal reference. The most
    // sensitive document in the product.
    //
    // Its owner may read it. Nobody else can, not even a landlord with an open application:
    // what a landlord sees is the **snapshot** frozen inside that application, which is what
    // was declared to them. Editing the profile afterwards cannot rewrite what they were told,
    // and a landlord cannot follow it to whatever the tenant declares to someone else.
    //
    // `list` is denied outright: a query over this collection is a list of everyone's income.
    match /tenantProfiles/{userId} {
      allow get:  if isOwner(userId) || isAdmin();
      allow list: if false;
      allow create, update, delete: if false;   // Server Actions only

      // The papers themselves live in Cloud Storage; this is only what was uploaded and when.
      // Same reading as the profile: its owner, and nobody else. A landlord reviewing an
      // application is served time-limited signed URLs by the server, which is what lets the
      // bucket stay private — a landlord who saw this collection could follow it after the
      // process ended, or to documents uploaded for somebody else entirely.
      match /documents/{documentId} {
        allow get:  if isOwner(userId) || isAdmin();
        allow list: if isOwner(userId) || isAdmin();
        allow create, update, delete: if false;   // Server Actions only
      }
    }

    // -------------------------------- leases --------------------------------
    // The tenancy, once it is running: `leases/{leaseId}` with `leaseId == applicationId`.
    //
    // Read-only for its two parties, exactly like the application. Every write is a Server Action
    // with the Admin SDK, and that is not belt-and-braces: the rules that have to hold — the month
    // has to be on the tenancy's own schedule, a verdict belongs to the receipt it judged, the
    // landlord confirms and the tenant uploads — are relationships between documents and dates,
    // which is the one thing a `firestore.rules` file cannot ask about. A rule that enforced half
    // of them would be a rule somebody trusts.
    //
    // `list` is bounded and filtered per side, the same shape as applications: a tenancy is
    // private to the two people in it, and an unfiltered sweep would be a list of who is renting
    // what.
    match /leases/{leaseId} {
      allow get:  if isLeaseTenant() || isLeaseLandlord() || isAdmin();
      allow list: if isAdmin()
                  || (isSignedIn()
                      && request.query.limit <= 50
                      && (isLeaseTenant() || isLeaseLandlord()));

      allow create, update, delete: if false;   // Server Actions only

      function isLeaseTenant() {
        return isSignedIn() && current().tenantUid == uid();
      }
      function isLeaseLandlord() {
        return isSignedIn() && current().landlordUid == uid();
      }
      /*
       * The parties, read from the tenancy itself, for the subcollections underneath it.
       *
       * Inside `periods` or `incidents` `resource` is that document, which carries no uid — so the
       * two uids have to come from the parent, and that is one `get` per request. The alternative is
       * a copy of both on every month and every report, and a copy that can disagree with the
       * tenancy it belongs to.
       *
       * Declared here rather than once per subcollection: it was duplicated the day the second one
       * arrived, and two copies of "who may read this tenancy" is the pair whose first divergence
       * nobody would notice.
       */
      function isParentLeaseParty() {
        let lease = get(/databases/$(database)/documents/leases/$(leaseId)).data;
        return lease.tenantUid == uid() || lease.landlordUid == uid();
      }

      // One month. The document id IS the month, which is what makes a monthly charge idempotent.
      //
      // The parties have to be read from the parent: inside this match `resource` is the period,
      // which carries no uid. That is one `get` per request, which is why the period document does
      // not denormalize them — the alternative is a copy of both uids on every month, and a copy
      // that could disagree with the tenancy it belongs to.
      //
      // Parentheses are not optional: `&&` binds tighter than `||`.
      match /periods/{period} {
        allow get, list: if isAdmin() || (isSignedIn() && isParentLeaseParty());
        allow create, update, delete: if false;  // Server Actions only
      }

      // What went wrong in the property while the tenancy runs: a leak, a broken boiler. Reported
      // by the tenant, read by both — the same audience as a month, and for the same reason it is
      // the same rule: an incident says where somebody lives and what is broken in it.
      //
      // Written only by the Server Action, like everything else under a tenancy. The checks that
      // have to hold are not expressible here: the reporter has to be a party to *this* tenancy,
      // each attachment has to sit in the reporter's own Storage folder, and the file has to
      // actually exist in the bucket with the type it claims. A rule that enforced the shape but
      // none of that would be a rule somebody trusts.
      match /incidents/{incidentId} {
        allow get, list: if isAdmin() || (isSignedIn() && isParentLeaseParty());
        allow create, update, delete: if false;  // Server Actions only
      }
    }

    // -------------------------- contracts and payments ----------------------
    // Read-only for the parties. The backend writes them through the Admin SDK.
    match /contracts/{contractId} {
      allow get:  if isContractParty() || isAdmin();
      allow list: if false;                    // queried from the server
      allow create, update, delete: if false;  // Admin SDK only

      function isContractParty() {
        return isSignedIn()
            && (current().tenantUid == uid() || current().landlordUid == uid());
      }

      match /payments/{paymentId} {
        allow get, list: if isAdmin()
                         || (isSignedIn() && isParentContractParty());
        allow write: if false;                 // payments are recorded by the backend

        function isParentContractParty() {
          let contract = get(/databases/$(database)/documents/contracts/$(contractId)).data;
          return contract.tenantUid == uid() || contract.landlordUid == uid();
        }
      }
    }

    // --------------------------- explicit closure ---------------------------
    // Any path not declared above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
