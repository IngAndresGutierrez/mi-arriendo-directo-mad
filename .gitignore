# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Committed on purpose: it points at the emulators and holds no credential.
!.env.e2e
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# firebase emulators
firebase-debug.log
firestore-debug.log
firebase-export-*/
.firebase/

# agent scratch scripts — throwaway drivers and one-off admin scripts belong in the
# session scratchpad, never in the repo root. `.c.mjs` reads .env.local and deletes
# accounts; `verify-login.mjs` was committed this way once already.
/.c.mjs
/verify-*.mjs
/driver/

# e2e screenshots and generated upload fixtures
/.e2e-shots/
