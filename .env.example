# =============================================================================
# Copia este archivo a .env.local y complétalo. NUNCA commitees .env.local.
# =============================================================================

# --- Config pública del SDK web (SÍ llega al navegador, es correcto) ---------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Opcional: solo si usas Google Analytics.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# --- Credenciales del Admin SDK (SOLO servidor) ------------------------------
# JAMÁS les pongas el prefijo NEXT_PUBLIC_: eso las publicaría en el bundle del
# navegador. Salen del JSON del service account de Firebase Console.
# La private key va entre comillas y con los saltos de línea escapados (\n).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""

# --- Desarrollo local con emuladores ----------------------------------------
# Pon 1 para que el SDK del cliente apunte a los emuladores.
NEXT_PUBLIC_FIREBASE_USE_EMULATOR=0
# Para que el Admin SDK use los emuladores, descomenta:
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Only needed to point the links somewhere the request cannot reveal — a tunnel, a staging
# domain. Left unset, every link is built from the origin the request came in on: localhost
# while developing, the preview's own domain on a preview, the real one in production.
# NEXT_PUBLIC_SITE_URL=

# Resend, provisioned from the Vercel Marketplace: the integration sets both. The domain is
# read rather than hardcoded because the `from` address must match a verified one exactly —
# Resend answers 403 otherwise, and nothing fails until a real email does not leave.
# Without RESEND_API_KEY the app logs the email instead of sending it, which is how the flow
# is exercised locally without mailing anyone.
RESEND_API_KEY=
RESEND_EMAIL_DOMAIN=miarriendodirecto.com
# Optional override for the whole From header. Defaults to
# "miarriendoDIRECTO <no-responder@$RESEND_EMAIL_DOMAIN>".
# EMAIL_FROM=

# Interview reminders (one day before, ten minutes before) are sent by a Vercel Cron job that
# calls /api/cron/interview-reminders every five minutes. The route refuses to run without this
# secret: a job that emails and messages people is not something to leave open. Vercel sends it
# as `Authorization: Bearer $CRON_SECRET`. Any long random string works.
CRON_SECRET=

# WhatsApp, through Meta's Cloud API. All three are needed before a single message can leave:
# business-initiated messages have to use a template Meta approved beforehand, so the words live
# in the WhatsApp Business account and this project only passes the parameters (property, when).
# Without them the reminder still goes out by bell and email, and the WhatsApp is logged.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
# Defaults to interview_reminder / es_CO.
# WHATSAPP_TEMPLATE=
# WHATSAPP_TEMPLATE_LOCALE=

# --- SMS (opcional): el código de firma por mensaje de texto -------------------
# El Marketplace de Vercel no tiene proveedor de SMS, así que esto se configura a mano.
# Hacen falta las tres o el canal no se ofrece: sin número de origen Twilio no sabe de parte
# de quién manda, y un canal a medio configurar es el que falla cuando alguien lo elige.
#
# Es el más débil de los tres canales de firma (SIM swap) y tiene coste por mensaje.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# WhatsApp por Twilio, para los encargos del colaborador. El `FROM` es un número de Twilio con
# WhatsApp habilitado (o el del sandbox, `+14155238886`, al que hay que unirse desde cada teléfono).
#
# El TEMPLATE_SID es un Content Template aprobado, y no es opcional en la práctica: fuera de la
# ventana de 24 horas que abre el mensaje de la persona, WhatsApp solo entrega plantillas — es regla
# de WhatsApp, no de Twilio, así que aplica con cualquier proveedor. Sin él se manda texto libre, que
# sirve para desarrollar y no para producción.
TWILIO_WHATSAPP_FROM=

# Dos plantillas, no una: el encargo manda tres variables y el código de acceso una, y Meta las
# clasifica distinto —UTILITY frente a AUTHENTICATION—, con reglas de aprobación y precio distintos.
# Una sola variable para las dos habría mandado tres de los cuatro mensajes con la plantilla
# equivocada. El orden de {{1}} {{2}} {{3}} tiene que coincidir con `variables:` en el código.
#
# Sin ellas se manda texto libre, que WhatsApp solo entrega dentro de la ventana de 24 horas.
TWILIO_WHATSAPP_ERRAND_TEMPLATE_SID=
TWILIO_WHATSAPP_OTP_TEMPLATE_SID=

# --- WhatsApp para el código de firma (opcional) ------------------------------
# Una plantilla aprobada por Meta en la categoría AUTHENTICATION. Sin esto el canal no se ofrece.
WHATSAPP_OTP_TEMPLATE=
